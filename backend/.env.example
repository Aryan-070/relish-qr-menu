# Relish backend — environment template. Copy to backend/.env (gitignored).
# All values below are safe local defaults / placeholders.

# ── Core ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────────
# Leave unset to use local SQLite. For Postgres (docker-compose / prod):
# DATABASE_URL=postgres://relish:relish@localhost:5432/relish
# DATABASE_URL=

# ── Redis (cache, Channels layer, Celery broker). Unset = in-memory. ────────
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# CELERY_TASK_ALWAYS_EAGER=false

# ── Frontend origins (CORS) ─────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Object storage (Phase 4). USE_S3=true switches default storage to S3/R2. ─
USE_S3=false
# AWS_STORAGE_BUCKET_NAME=relish-media
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Razorpay (SERVER ONLY — never expose the secret to the browser) ─────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
