# Relish backend — environment template. Copy to backend/.env (gitignored).
# All values below are safe local defaults / placeholders.

# ── Core ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
# Production only: forces HTTPS redirect + HSTS + secure cookies (set in deploy configs).
DJANGO_SECURE_SSL=false
# Expose /api/schema/ + /api/docs/ without auth? Default false in prod (admin-only).
SCHEMA_PUBLIC=false
# Secret to enable the one-time demo seed endpoint POST /api/admin/seed-demo/
# (send it as the X-Seed-Token header). Unset = endpoint 404s.
SEED_TOKEN=
DJANGO_ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://api.relish.app,https://relish.app
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────────
# Leave unset to use local SQLite. For Postgres (docker-compose / prod):
# DATABASE_URL=postgres://relish:relish@localhost:5432/relish
# DATABASE_URL=

# ── Redis (cache, Channels layer, Celery broker). Unset = in-memory. ────────
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# CELERY_TASK_ALWAYS_EAGER=false

# ── Frontend origins (CORS) ─────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Object storage (Phase 4). USE_S3=true switches default storage to S3/R2. ─
USE_S3=false
# AWS_STORAGE_BUCKET_NAME=relish-media
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Public base for serving uploaded media (CDN / Supabase public object URL):
# ASSET_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/relish-media
# Supabase Storage (S3-compatible) example:
#   USE_S3=true
#   AWS_STORAGE_BUCKET_NAME=relish-media
#   AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
#   AWS_S3_REGION_NAME=<project region, e.g. ap-south-1>
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY = Supabase Storage S3 access keys
# Set False to skip ffmpeg transcoding (no worker) — videos serve the original:
# MEDIA_TRANSCODE_ENABLED=true

# ── Razorpay (SERVER ONLY — never expose the secret to the browser) ─────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Observability (Sentry — no-op when DSN is unset) ────────────────────────
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_ENV=production

# ── Media uploads (Phase 4) ─────────────────────────────────────────────────
# ASSET_PUBLIC_BASE_URL=https://cdn.example.com   # CDN base for served media
# ASSET_IMAGE_MAX_BYTES=8000000
# ASSET_VIDEO_MAX_BYTES=200000000
# ASSET_TENANT_QUOTA_BYTES=5000000000

# ── RLS backstop activation (production hardening) ──────────────────────────
# The 0001_rls_backstop migration adds tenant-isolation policies but does NOT
# force them. To activate the backstop, connect the app as a NON-superuser,
# NON-owner role and `ALTER TABLE … FORCE ROW LEVEL SECURITY` per tenant table.
# The TenantMiddleware already sets the app.current_restaurant session GUC.
