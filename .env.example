# Relish — environment variables.
# Copy this file to `.env.local` (git-ignored) and fill in the values, OR set
# them in Vercel → Project → Settings → Environment Variables.
#
# Leave BOTH blank to run the localStorage demo (no backend). The app builds,
# deploys and works without these — auth/data only activate when they're set.
#
# Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay (optional — real subscription-renewal payments).
# Inert until set: billing falls back to the demo "mark paid" action.
# Only VITE_RAZORPAY_KEY_ID is exposed to the client bundle; the others are
# read solely by the Vercel serverless functions under `api/razorpay/` and
# must NEVER be prefixed with VITE_ (that would leak them to the browser).
# VITE_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
