# Relish — environment variables.
# Copy this file to `.env.local` (git-ignored) and fill in the values, OR set
# them in Vercel → Project → Settings → Environment Variables.

# ── Django/DRF backend ───────────────────────────────────────────────────────
# API base for the staff console + guest storefront (defaults to
# http://localhost:8000/api when unset).
VITE_API_BASE_URL=http://localhost:8000/api
# The restaurant the root URL (`/`) serves the live menu for. Without it the
# root storefront has no menu; `/demo` always works (bundled demo data).
# Override per-URL with `?r=<restaurant_id>`.
VITE_DEFAULT_RESTAURANT_ID=

# ── Supabase (DEPRECATED — retired for the Django backend) ────────────────────
# Kept only for the legacy serverless billing functions; the console no longer
# uses these for auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# Razorpay (optional — real subscription-renewal payments).
# Inert until set: billing falls back to the demo "mark paid" action.
# Only VITE_RAZORPAY_KEY_ID is exposed to the client bundle; the others are
# read solely by the Vercel serverless functions under `api/razorpay/` and
# must NEVER be prefixed with VITE_ (that would leak them to the browser).
# VITE_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Serverless-only Supabase access for the Vercel functions under `api/`
# (Razorpay webhook marks invoices paid; usage endpoint records video egress).
# Service role bypasses RLS — server-only, NEVER prefix with VITE_.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
